<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back" />

            <TextView
                android:id="@+id/txtModuleTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:text="MATT202"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtModuleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Real Analysis"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Current Average"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCurrentAverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="74.3%"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/txtSecuredMark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secured: 29.7%" />

        <TextView
            android:id="@+id/txtCompletedWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completed: 40%" />

        <TextView
            android:id="@+id/txtRemainingWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remaining: 60%" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Exam Entrance"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtExamEntrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YES"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtRequiredForEntrance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required average for remaining class work: 55%" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Assessments"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAssessments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/btnAddAssessment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add Assessment" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Target"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTargetMark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target final mark"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/txtRequiredForTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required average: -" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:text="Projection"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtProjectedAverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expected average for remaining work"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/txtProjectedFinalMark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Projected final mark: -" />

    </LinearLayout>

</ScrollView>