<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (dark). -->
    <style name="Base.Theme.GradeHub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_container_light</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <item name="colorError">@color/grade_risk</item>

        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="materialCardViewStyle">@style/Widget.GradeHub.CardView</item>
        <item name="textInputStyle">@style/Widget.GradeHub.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.GradeHub.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.GradeHub.Fab</item>
        <item name="toolbarStyle">@style/Widget.GradeHub.Toolbar</item>
    </style>
</resources>